PORT=8000
NODE_ENV=development

APP_API_KEY=change_this_internal_api_key

# Mailjet SMTP server host.
# Usually: in-v3.mailjet.com
MAILJET_SMTP_HOST=in-v3.mailjet.com

# SMTP port.
# Usually: 587 for TLS/STARTTLS.
MAILJET_SMTP_PORT=587

# Mailjet API key / public key.
# In the Mailjet dashboard, this is shown in SMTP and SEND API settings.
# Used as the SMTP username.
MAILJET_SMTP_USER=your_mailjet_api_key

# Mailjet Secret Key.
# Used as the SMTP password.
# Mailjet may only show the secret key once when created, so save it securely.
MAILJET_SMTP_PASS=your_mailjet_secret_key

# Verified sender email/domain in Mailjet.
# This email/domain must be verified in Mailjet before sending.
MAIL_FROM_EMAIL=noreply@yourdomain.com

# Display name shown to recipients.
MAIL_FROM_NAME=Your Organization
