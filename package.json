{
  "name": "email-blaster-api",
  "version": "1.0.0",
  "description": "A small Express.js TypeScript API for sending email blasts with Mailjet SMTP and Nodemailer.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/certificateBlaster.check.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "nodemailer",
    "mailjet",
    "email"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "nodemailer": "^8.0.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
